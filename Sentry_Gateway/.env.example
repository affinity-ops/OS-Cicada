# ── Cicada Sentry Gateway Environment Variables ──

# PostgreSQL connection string
CICADA_POSTGRES_URL=postgres://cicada_admin:local_dev_password@localhost:5432/cicada_ledger?sslmode=disable

# Redis connection string
CICADA_REDIS_URL=redis://localhost:6379

# Ed25519 key file path (generated on first boot if missing)
CICADA_KEY_PATH=sentry_ed25519.key

# AES-256 master key for tenant API key encryption (must be exactly 32 bytes)
CICADA_AES_MASTER_KEY=CHANGE_ME_32_BYTE_SECRET_KEY_NOW

# Aegis-0 MCP master authentication token
CICADA_AEGIS_TOKEN=CHANGE_ME_STRONG_RANDOM_TOKEN

# Edge ledger SQLite path
CICADA_LEDGER_PATH=cicada_edge_ledger.db

# Central vault sync URL
CICADA_VAULT_URL=http://localhost:8081

# Central vault authentication token
CICADA_VAULT_TOKEN=

# Server port
PORT=8080

# WebSocket CORS origins (comma-separated, empty = allow all for dev)
CICADA_CORS_ORIGINS=

# Additional allowed IPs for Aegis MCP (comma-separated)
CICADA_AEGIS_ALLOWED_IPS=

# Shadow Sandbox URL (Docker container receiving ghost-mode agent traffic)
SHADOW_SANDBOX_URL=http://localhost:9090

# Fail-closed on database errors: when true, role and FGA checks deny if
# PostgreSQL is unreachable rather than defaulting to allow.
# DEFAULT: true (secure-by-default). Override to false ONLY for local dev.
FAIL_CLOSED_ON_DB_ERROR=true

# Ghost mode TTL in hours (default: 4)
GHOST_MODE_TTL_HOURS=4

# Gossip mesh: comma-separated peer URLs for multi-node deployments
# Example: https://sentry-b.internal:8080,https://sentry-c.internal:8080
CICADA_GOSSIP_PEERS=

# Gossip HMAC secret: shared secret for inter-node gossip authentication.
# REQUIRED when CICADA_GOSSIP_PEERS is set. Generate with:
#   openssl rand -hex 32
CICADA_GOSSIP_SECRET=
