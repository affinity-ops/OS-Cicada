# ==============================================================================
# Cicada Sovereign Agent Gateway — Environment Configuration Template
# ==============================================================================

# ── General Server Settings ───────────────────────────────────────────────────
NODE_ENV=development
CICADA_REGION=us-east-1
CICADA_FAIL_CLOSED=true
CICADA_SIMULATION_MODE=false

# ── Sentry Gateway (Go) ───────────────────────────────────────────────────────
SENTRY_PORT=8080
CICADA_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000
CICADA_USER_CONTEXT_REQUIRED=false
CICADA_USER_CONTEXT_JWKS_URL=
CICADA_USER_CONTEXT_ISSUERS=
CICADA_USER_CONTEXT_AUDIENCES=

# ── Database & Redis ──────────────────────────────────────────────────────────
# These exact names are read by Sentry_Gateway (internal/store, internal/queue)
# and by start_fleet.sh's pre-flight checks.
CICADA_POSTGRES_URL=postgres://localhost:5432/cicada_db?sslmode=disable
CICADA_REDIS_URL=redis://localhost:6379
# Kept for tools that expect the generic names.
DATABASE_URL=${CICADA_POSTGRES_URL}
REDIS_URL=${CICADA_REDIS_URL}

# ── Core API (Laravel) ────────────────────────────────────────────────────────
APP_NAME="Cicada Core API"
APP_ENV=local
APP_KEY=base64:GENERATE_YOUR_OWN_LARAVEL_KEY_HERE
APP_URL=http://localhost:8000

# ── AI Model Provider Keys (Populate for live LLM proxying) ───────────────────
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── OpenTelemetry Tracing ─────────────────────────────────────────────────────
OTEL_EXPORTER=stdout
OTEL_SERVICE_NAME=sentry-gateway
